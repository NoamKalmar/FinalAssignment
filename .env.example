# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

PORT=3000

# --- Database -------------------------------------------------------------
# Two options. Keep one active, comment the other out.
#
# 1) Local MongoDB — no internet needed. Good fallback for the defense.
# MONGODB_URI=mongodb://127.0.0.1:27017
#
# 2) MongoDB Atlas — shared by the whole team, so everyone sees the same data.
#    Requires Network Access -> 0.0.0.0/0 in the Atlas dashboard.
#    No trailing slash, and no database name in the URI.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# The database name lives here, not in the URI, so switching between the two
# options above is a one-line change.
DB_NAME=socialnet

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Filled in when M7 (map) starts
GOOGLE_MAPS_API_KEY=

# --- Facebook Graph API (§33.iv) ---------------------------------------
# The lecturer approved Facebook in place of X, which moved to pay-per-use.
# Keep the Meta app in Development Mode: anyone holding an Admin/Developer/
# Tester role then gets full permissions without App Review.
#
# PAGE_ACCESS_TOKEN must be the NEVER-EXPIRING one, obtained by exchanging a
# short-lived user token for a long-lived one and then calling /me/accounts.
# A token straight out of Graph API Explorer dies after about an hour.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
