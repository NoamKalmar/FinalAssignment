<%- include('../partials/head') %>
    <%- include('../partials/nav') %>

        <main class="container" style="max-width:640px">

            <p style="margin:0 0 14px"><a class="back" href="/feed">&larr; Back to feed</a></p>

            <%- include('../partials/post-card', { post }) %>
                <section class="fb-panel" id="comments">
        <h2>Comments (<%= comments.length %>)</h2>

        <% comments.forEach(function(comment) { %>
            <div class="comment" style="padding:10px 0;border-bottom:1px solid #eee">
                <strong><%= comment.author.fullName %></strong>
                <span style="color:#888;font-size:0.85em"> · <%= comment.createdAt.toLocaleString() %></span>
                <% if (comment.updatedAt) { %><span style="color:#888;font-size:0.8em"> (edited)</span><% } %>
                <p style="margin:4px 0"><%= comment.content %></p>
                <form method="POST" action="/posts/<%= post._id %>/comments/<%= comment._id %>/like" style="display:inline">
    <button type="submit" class="btn btn-outline btn-inline" style="font-size:0.8em">
        <%= (comment.likes || []).some(function(id) { return String(id) === String(currentUser._id); }) ? 'Unlike' : 'Like' %> (<%= (comment.likes || []).length %>)
    </button>
</form>

                <%# Author-only controls. The server checks again in
                    commentController — hiding these is presentation, not security. %>
                <% if (String(comment.author._id) === String(currentUser._id)) { %>
                    <button type="button" class="btn btn-outline btn-inline" style="font-size:0.8em"
                            onclick="toggleCommentEdit('<%= comment._id %>')">Edit</button>

                    <form method="POST" action="/posts/<%= post._id %>/comments/<%= comment._id %>/delete"
                          style="display:inline" onsubmit="return confirm('Delete this comment?')">
                        <button type="submit" class="btn btn-outline btn-inline" style="font-size:0.8em">Delete</button>
                    </form>

                    <form method="POST" action="/posts/<%= post._id %>/comments/<%= comment._id %>/edit"
                          id="edit-<%= comment._id %>" style="display:none;margin-top:6px">
                        <textarea name="content" rows="2" maxlength="500" required
                                  style="width:100%;padding:8px"><%= comment.content %></textarea>
                        <button type="submit" class="btn btn-primary btn-inline" style="font-size:0.8em;margin-top:4px">Save</button>
                        <button type="button" class="btn btn-outline btn-inline" style="font-size:0.8em"
                                onclick="toggleCommentEdit('<%= comment._id %>')">Cancel</button>
                    </form>
                <% } %>
            </div>
        <% }); %>

        <form method="POST" action="/posts/<%= post._id %>/comments" style="margin-top:14px">
            <textarea name="content" rows="2" maxlength="500" placeholder="Write a comment..."
                      style="width:100%;padding:8px" required></textarea>
            <button type="submit" class="btn btn-primary btn-inline" style="margin-top:6px">Comment</button>
        </form>

        <script>
            // Swaps a comment between its text and its edit form. Plain
            // show/hide — the form posts normally, no Ajax needed here.
            function toggleCommentEdit(id) {
                var form = document.getElementById('edit-' + id);
                form.style.display = form.style.display === 'none' ? 'block' : 'none';
            }
        </script>
    </section>

    <%# §33.iv — Facebook. Visible to the author only; isOwner enforces it.
        Also hidden when the server has no Page credentials, so a machine
        without a token shows a clean page instead of a button that 503s. %>
    <% if (facebookConfigured && String(post.author._id) === String(currentUser._id)) { %>
        <section class="fb-panel">
            <div class="fb-head">
                <h2>Facebook</h2>
                <% if (post.facebookPostId) { %>
                    <span class="badge admin">shared</span>
                <% } %>
            </div>

            <% if (!post.facebookPostId) { %>
                <p class="fb-note">
                    Publish this post to the SocialNet Facebook Page. The server
                    calls the Graph API directly &mdash; this is not a share widget.
                </p>
                <form method="POST" action="/posts/<%= post._id %>/share">
                    <button class="btn btn-primary btn-inline" type="submit">Share to Facebook</button>
                </form>
            <% } else { %>
                <div id="fb-engagement" class="fb-engagement">reading engagement from Facebook&hellip;</div>
                <form method="POST" action="/posts/<%= post._id %>/unshare"
                      onsubmit="return confirm('Remove this post from the Facebook Page?')">
                    <button class="btn btn-outline btn-inline" type="submit">Remove from Facebook</button>
                </form>
                <script>
                    // The receive half of §33.iv: our server asks Graph for the
                    // like and comment totals, we render them here.
                    fetch('/posts/<%= post._id %>/engagement')
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            var el = document.getElementById('fb-engagement');
                            if (!d.ok) { el.textContent = 'Facebook engagement unavailable right now.'; return; }
                            el.innerHTML =
                                '<span class="fb-stat"><strong>' + d.likes + '</strong> likes</span>' +
                                '<span class="fb-stat"><strong>' + d.comments + '</strong> comments</span>' +
                                (d.permalink ? '<a class="fb-link" target="_blank" rel="noopener" href="' + d.permalink + '">view on Facebook &rarr;</a>' : '');
                        })
                        .catch(function () {
                            document.getElementById('fb-engagement').textContent = 'Facebook engagement unavailable right now.';
                        });
                </script>
            <% } %>
        </section>
    <% } %>
    
<%# Twitter/X — §33.iv. Same visibility rule as Facebook: author only,
        and hidden if the server has no Twitter credentials configured. %>
    <% if (twitterConfigured && String(post.author._id) === String(currentUser._id)) { %>
        <section class="fb-panel">
            <div class="fb-head">
                <h2>Twitter / X</h2>
                <% if (post.twitterPostId) { %>
                    <span class="badge admin">shared</span>
                <% } %>
            </div>

            <% if (!post.twitterPostId) { %>
                <p class="fb-note">
                    Publish this post as a tweet. The server calls the Twitter
                    API directly &mdash; this is not a share widget.
                </p>
                <form method="POST" action="/twitter/<%= post._id %>/share">
                    <button class="btn btn-primary btn-inline" type="submit">Share to Twitter</button>
                </form>
            <% } else { %>
                <div id="tw-engagement" class="fb-engagement">reading engagement from Twitter&hellip;</div>
                <form method="POST" action="/twitter/<%= post._id %>/unshare"
                      onsubmit="return confirm('Delete this tweet?')">
                    <button class="btn btn-outline btn-inline" type="submit">Remove from Twitter</button>
                </form>
                <script>
                    // The receive half of §33.iv: our server asks Twitter for
                    // like/retweet totals, we render them here.
                    fetch('/twitter/<%= post._id %>/engagement')
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            var el = document.getElementById('tw-engagement');
                            if (!d.success || !d.engagement) { el.textContent = 'Twitter engagement unavailable right now.'; return; }
                            var eng = d.engagement;
                            el.innerHTML =
                                '<span class="fb-stat"><strong>' + eng.likes + '</strong> likes</span>' +
                                '<span class="fb-stat"><strong>' + eng.retweets + '</strong> retweets</span>' +
                                '<span class="fb-stat"><strong>' + eng.comments + '</strong> replies</span>' +
                                (eng.permalink ? '<a class="fb-link" target="_blank" rel="noopener" href="' + eng.permalink + '">view on Twitter &rarr;</a>' : '');
                        })
                        .catch(function () {
                            document.getElementById('tw-engagement').textContent = 'Twitter engagement unavailable right now.';
                        });
                </script>
            <% } %>
        </section>
    <% } %>
        </main>

        <%- include('../partials/footer') %>
