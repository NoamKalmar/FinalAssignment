<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container" style="max-width:1050px;padding:32px 20px">

    <header class="stats-page-header">
        <div class="stats-badge">LIVE DATABASE ANALYTICS</div>
        <h1 style="font-size:2rem;margin:8px 0 6px;letter-spacing:-0.5px">Platform Statistics & Analytics</h1>
        <p style="color:var(--muted);margin:0;font-size:0.95rem">
            Real-time data aggregated directly from MongoDB and visualized with D3.js.
        </p>
    </header>

    <!-- KPI Summary Grid -->
    <section class="stats-kpi-grid">
        <div class="stats-kpi-card">
            <div class="kpi-icon" style="background:rgba(108,140,255,0.15);color:#6c8cff">👥</div>
            <div class="kpi-info">
                <span class="kpi-value"><%= statsData.counts.users %></span>
                <span class="kpi-label">Total Users</span>
            </div>
        </div>
        <div class="stats-kpi-card">
            <div class="kpi-icon" style="background:rgba(255,91,127,0.15);color:#ff5b7f">📝</div>
            <div class="kpi-info">
                <span class="kpi-value"><%= statsData.counts.posts %></span>
                <span class="kpi-label">Total Posts</span>
            </div>
        </div>
        <div class="stats-kpi-card">
            <div class="kpi-icon" style="background:rgba(34,197,94,0.15);color:#22c55e">🌐</div>
            <div class="kpi-info">
                <span class="kpi-value"><%= statsData.counts.groups %></span>
                <span class="kpi-label">Active Groups</span>
            </div>
        </div>
        <div class="stats-kpi-card">
            <div class="kpi-icon" style="background:rgba(255,154,91,0.15);color:#ff9a5b">📍</div>
            <div class="kpi-info">
                <span class="kpi-value"><%= statsData.counts.places %></span>
                <span class="kpi-label">Saved Places</span>
            </div>
        </div>
        <div class="stats-kpi-card">
            <div class="kpi-icon" style="background:rgba(168,85,247,0.15);color:#a855f7">❤️</div>
            <div class="kpi-info">
                <span class="kpi-value"><%= statsData.counts.likes %></span>
                <span class="kpi-label">Total Likes</span>
            </div>
        </div>
    </section>

    <!-- Charts Grid -->
    <div class="stats-charts-grid">

        <!-- Chart 1: Post Types (Donut) -->
        <section class="stats-chart-card">
            <div class="chart-header">
                <div class="chart-title-wrap">
                    <h3>Post Content Distribution</h3>
                    <p class="chart-subtitle">Proportion of text, image, and video media</p>
                </div>
                <span class="chart-badge">D3 Donut Chart</span>
            </div>
            <div id="post-types-chart" class="chart-body"></div>
        </section>

        <!-- Chart 2: Groups by Category (Bar Chart) -->
        <section class="stats-chart-card">
            <div class="chart-header">
                <div class="chart-title-wrap">
                    <h3>Groups by Category</h3>
                    <p class="chart-subtitle">Distribution of community groups across categories</p>
                </div>
                <span class="chart-badge">D3 Bar Chart</span>
            </div>
            <div id="group-categories-chart" class="chart-body"></div>
        </section>

    </div>

    <!-- Chart 3: Post Activity Timeline (Full Width Area Chart) -->
    <section class="stats-chart-card" style="margin-top:24px">
        <div class="chart-header">
            <div class="chart-title-wrap">
                <h3>Posting Activity Trends</h3>
                <p class="chart-subtitle">Daily frequency of new posts created across the network</p>
            </div>
            <span class="chart-badge">D3 Timeline Curve</span>
        </div>
        <div id="activity-timeline-chart" class="chart-body" style="min-height:240px"></div>
    </section>

</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const statsData = <%- JSON.stringify(statsData) %>;

        // 1. Render Post Content Distribution Donut Chart
        const postTypeColors = {
            text: '#6c8cff',
            image: '#ff5b7f',
            video: '#22c55e'
        };

        const formattedPostTypes = (statsData.postTypes || []).map(item => ({
            label: item.type,
            value: item.count,
            color: postTypeColors[item.type] || '#ff9a5b'
        }));

        SocialNetCharts.renderDonutChart('#post-types-chart', formattedPostTypes, {
            centerLabel: 'Posts',
            innerRadius: 65,
            width: 380,
            height: 250,
            showLegend: true
        });

        // 2. Render Group Categories Bar Chart
        SocialNetCharts.renderBarChart('#group-categories-chart', statsData.categoryStats || [], {
            xKey: 'category',
            yKey: 'groupCount',
            yLabel: 'Groups',
            barColor: '#6c8cff',
            barColorEnd: '#3b82f6',
            width: 480,
            height: 250
        });

        // 3. Render Post Activity Timeline Chart
        SocialNetCharts.renderTimelineChart('#activity-timeline-chart', statsData.activityTimeline || [], {
            width: 960,
            height: 230
        });
    });
</script>

<%- include('../partials/footer') %>
