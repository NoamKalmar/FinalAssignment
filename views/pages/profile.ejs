<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
const initials = (user.fullName || '?').split(' ').map(w => w[0]).slice(0, 2).join('');
const friendCount = (user.friendsList && user.friendsList.length) || (user.friends && user.friends.length) || 0;
%>

<main class="container">

    <div class="profile-header">
        <div class="profile-head-info">
            <div class="avatar lg"><%= initials %></div>
            <div>
                <h1 style="margin:0 0 4px"><%= user.fullName %></h1>
                <p style="color:var(--muted);margin:0">@<%= user.username %></p>
            </div>
        </div>
        <div style="display:flex;gap:10px">
            <a href="/profile/edit"><button class="btn btn-outline btn-inline">Edit profile</button></a>
            <a href="/friends"><button class="btn btn-primary btn-inline" style="margin-top:0">Manage friends</button></a>
        </div>
    </div>

    <section style="margin-top:20px;padding:22px;border:1px solid var(--divider);
                    border-radius:var(--radius);background:var(--surface)">
        <p style="margin:0 0 8px"><strong>Email:</strong> <%= user.email %></p>
        <% if (user.address && (user.address.city || user.address.street)) { %>
            <p style="margin:0 0 8px"><strong>Location:</strong>
                <%= [user.address.street, user.address.city].filter(Boolean).join(', ') %>
            </p>
        <% } %>
        <p style="margin:0 0 8px"><strong>Bio:</strong>
            <%= user.bio || 'No bio provided yet.' %></p>
        <p style="margin:0"><strong>Joined:</strong>
            <%= user.createdAt.toLocaleDateString('en-GB') %></p>
    </section>

    <section style="margin-top:24px;padding:22px;border:1px solid var(--divider);
                    border-radius:var(--radius);background:var(--surface)">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <h2 style="margin:0;font-size:1.1rem">Friends (<%= friendCount %>)</h2>
            <a href="/friends" style="font-size:.85rem;color:var(--accent)">View all &rarr;</a>
        </div>

        <% if (user.friendsList && user.friendsList.length > 0) { %>
            <div class="chips">
                <% user.friendsList.slice(0, 12).forEach(f => {
                    const fInitials = (f.fullName || '?').split(' ').map(w => w[0]).slice(0, 2).join('');
                %>
                    <a href="/users/<%= f._id %>" class="chip">
                        <span class="avatar"><%= fInitials %></span>
                        <span><%= f.fullName %></span>
                    </a>
                <% }) %>
                <% if (friendCount > 12) { %>
                    <a href="/friends" class="chip" style="color:var(--muted)">+<%= friendCount - 12 %> more</a>
                <% } %>
            </div>
        <% } else { %>
            <p style="color:var(--muted);font-size:.88rem;margin:0">
                You haven't added any friends yet. <a href="/friends?tab=discover" style="color:var(--accent)">Find people to connect with &rarr;</a>
            </p>
        <% } %>
    </section>

    <!-- Personal Activity & Stats Section (D3.js) -->
    <% if (typeof userStats !== 'undefined') { %>
        <section class="stats-chart-card" style="margin-top:28px;max-width:550px">
            <div class="chart-header">
                <div class="chart-title-wrap">
                    <h3 style="font-size:1rem;margin:0 0 2px">Your Content & Engagement</h3>
                    <p class="chart-subtitle">Statistics on your posts and interactions</p>
                </div>
                <span class="chart-badge">Personal Stats</span>
            </div>

            <div style="display:flex;gap:14px;margin-bottom:16px">
                <div style="flex:1;background:var(--surface-2);padding:12px 16px;border-radius:10px;border:1px solid var(--divider)">
                    <div style="font-size:1.4rem;font-weight:700;color:var(--text)"><%= userStats.totalPosts %></div>
                    <div style="font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Total Posts</div>
                </div>
                <div style="flex:1;background:var(--surface-2);padding:12px 16px;border-radius:10px;border:1px solid var(--divider)">
                    <div style="font-size:1.4rem;font-weight:700;color:#ff5b7f"><%= userStats.totalLikes %></div>
                    <div style="font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Likes Received</div>
                </div>
            </div>

            <div id="user-post-types-chart" class="chart-body"></div>
        </section>

        <script id="user-stats-data" type="application/json">
            <%- JSON.stringify(userStats || {}) %>
        </script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const userStats = JSON.parse(document.getElementById('user-stats-data').textContent || '{}');
                const postTypeColors = {
                    text: '#6c8cff',
                    image: '#ff5b7f',
                    video: '#22c55e'
                };

                const formattedStats = (userStats.types || []).map(item => ({
                    label: item.type,
                    value: item.count,
                    color: postTypeColors[item.type] || '#ff9a5b'
                }));

                SocialNetCharts.renderDonutChart('#user-post-types-chart', formattedStats, {
                    centerLabel: 'Posts',
                    innerRadius: 48,
                    width: 320,
                    height: 200,
                    showLegend: true
                });
            });
        </script>
    <% } %>

</main>

<%- include('../partials/footer') %>
